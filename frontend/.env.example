# 洛谷档案馆 · 前端环境变量
# 复制到 .env 使用

# 浏览器直连的后端源站。默认 https://luogu.qzz.io（已开启 CORS）。
# 也可以填写 https://host/api 或 https://host/api/v1，程序会自动归一化为源站。
NUXT_PUBLIC_API_BASE_URL=https://luogu.qzz.io

# SSR 服务端使用的后端地址。留空时跟随 NUXT_PUBLIC_API_BASE_URL。
# 同机部署时可填 http://127.0.0.1:8001 走内网。
NUXT_API_INTERNAL_URL=

# 暂停展示模块（伪全网犇、题目、比赛）；设为 true 后重新构建即可恢复
NUXT_PUBLIC_EXTENDED_ARCHIVE_MODULES_ENABLED=false

# 人机验证
NUXT_PUBLIC_CAPTCHA_PROVIDER=turnstile          # turnstile / hcaptcha / aliyun / none
NUXT_PUBLIC_CAPTCHA_SITE_KEY=
NUXT_PUBLIC_CAPTCHA_ALIYUN_PREFIX=
NUXT_PUBLIC_CAPTCHA_ALIYUN_SCENE_ID=
NUXT_PUBLIC_CAPTCHA_ALIYUN_REGION=cn            # cn / sgp

# Umami 统计（只在公共页面加载，留空时关闭）
NUXT_PUBLIC_UMAMI_SCRIPT_URL=
NUXT_PUBLIC_UMAMI_WEBSITE_ID=
